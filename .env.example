# Copy this file to .env and fill in what you need. Both are optional.

# Free bearer token from https://get-energy-performance-data.communities.gov.uk
# Enables the "likely 4-bed" size filter on house prices.
EPC_TOKEN=

# Free key from https://api-portal.tfl.gov.uk (only needed if you hit rate limits)
TFL_APP_KEY=

# Port for the local server
PORT=5173

# Set to 0.0.0.0 to open Doorstep from your phone on the same Wi-Fi (default: this computer only)
# HOST=0.0.0.0
