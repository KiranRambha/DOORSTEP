{
  "name": "doorstep",
  "version": "0.1.0",
  "private": true,
  "description": "Look up schools, stations, commute times, house prices and crime around any address in England and Wales, using free open data.",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "setup": "node scripts/build-schools.mjs && node scripts/build-flood.mjs",
    "setup:flood": "node scripts/build-flood.mjs",
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-keys.mjs"
  }
}
